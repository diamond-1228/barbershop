# GitHub's language bar ignores documentation, generated, data, and prose paths.
# These overrides keep the other source languages visible.

*.sql linguist-detectable linguist-vendored=false linguist-generated=false linguist-documentation=false linguist-language=SQL
*.css linguist-detectable linguist-vendored=false linguist-generated=false linguist-documentation=false linguist-language=CSS
*.html linguist-detectable linguist-vendored=false linguist-generated=false linguist-documentation=false linguist-language=HTML
*.ps1 linguist-detectable linguist-vendored=false linguist-generated=false linguist-documentation=false linguist-language=PowerShell
*.md linguist-detectable linguist-documentation=false linguist-language=Markdown
*.json linguist-detectable linguist-generated=false linguist-language=JSON
*.yml linguist-detectable linguist-generated=false linguist-language=YAML
*.yaml linguist-detectable linguist-generated=false linguist-language=YAML

docs/** linguist-detectable linguist-documentation=false
supabase/** linguist-detectable linguist-vendored=false linguist-generated=false linguist-documentation=false
scripts/** linguist-detectable linguist-vendored=false linguist-generated=false
